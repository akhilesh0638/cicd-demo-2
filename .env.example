# Copy this file to .env and adjust values as needed.
# docker-compose.yml and the backend both read from these variables.

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=rootpass
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USERNAME=ecommerce_user
DB_PASSWORD=ecommerce_pass

# ---- Backend ----
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
DDL_AUTO=update
SQL_INIT_MODE=always

# ---- Frontend ----
# Backend URL the React app calls. When running via docker-compose and
# accessing the frontend from your host browser, keep this as localhost:8080
# since the browser resolves it, not the frontend container.
VITE_API_BASE_URL=http://localhost:8080/api
